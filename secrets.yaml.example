# Kopieer dit bestand naar `secrets.yaml` en vul je eigen waarden in.
# secrets.yaml staat in .gitignore en wordt NIET meegecommit.

wifi_ssid: "JouwWiFiNaam"
wifi_password: "JouwWiFiWachtwoord"

# Wachtwoord voor de fallback-hotspot (captive portal) als wifi wegvalt.
fallback_password: "kiesIetsSterks"

# API-encryptiesleutel (32 bytes base64). Genereer een nieuwe met:
#   openssl rand -base64 32
# of via het ESPHome-dashboard (maakt er automatisch één aan).
api_encryption: "GENEREER_EEN_EIGEN_SLEUTEL_32_BYTES_BASE64=="
